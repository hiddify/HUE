# Build artifacts
bin/
*.exe
coverage.out
coverage.html
*.cov
*.test
*.prof

# Generated code (regenerated by `make proto`)
gen/

# Generated by ent (regenerated by `make ent`)
internal/ent/*.go
internal/ent/enttest/
internal/ent/hook/
internal/ent/migrate/*.go
internal/ent/predicate/
internal/ent/runtime/
internal/ent/runtime.go
!internal/ent/schema/

# Local data and secrets
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
!.env.example
deployments/docker/secrets/*
!deployments/docker/secrets/.keep
deployments/docker/certs/*
!deployments/docker/certs/.keep
deployments/docker/geo/*
!deployments/docker/geo/.keep

# Buf
third_party/

# Tooling caches
.air.toml.local
tmp/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
